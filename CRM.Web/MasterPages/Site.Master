<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CRM.Web.MasterPages.SiteMaster" %>
<%@ Register TagPrefix="uc" TagName="Mensagens" Src="~/Controls/Mensagens.ascx" %>
<%@ Register TagPrefix="uc" TagName="ConfirmacaoModal" Src="~/Controls/ConfirmacaoModal.ascx" %>
<!DOCTYPE html>
<html lang="pt">
<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CRM Comercial</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="form1" runat="server" class="app-shell">
        <asp:ScriptManager ID="scriptManager" runat="server" />
        <!-- Barra superior: fixa, não faz scroll -->
        <nav class="navbar crm-topbar px-3 app-header">
            <span class="navbar-brand mb-0 brand" style="font-size:1.1rem;">CRM Comercial</span>
            <div class="d-flex align-items-center gap-3">
                <span class="avatar-badge">
                    <%: (Session["UserName"] as string ?? "?").Substring(0, 1).ToUpper() %>
                </span>
                <span class="text-muted" style="font-size:0.9rem;"><%: Session["UserName"] %></span>
                <asp:LinkButton ID="lnkLogout" runat="server" CssClass="btn btn-outline-secondary btn-sm"
                    OnClick="lnkLogout_Click">Sair</asp:LinkButton>
            </div>
        </nav>

        <!-- Botão para abrir o menu, só visível em mobile/tablet -->
        <nav class="navbar crm-topbar border-bottom d-lg-none px-3">
            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#menuLateral">
                ☰ Menu
            </button>
        </nav>

        <div class="app-body">

            <!-- Menu lateral -->
            <nav class="collapse d-lg-flex crm-sidebar p-3" id="menuLateral" runat="server">
                <ul class="nav flex-column w-100">
                    <li class="nav-item"><a class="nav-link" href="~/Dashboard/Dashboard.aspx" runat="server">Dashboard</a></li>

                    <!-- Comercial: Clientes, Contactos, Leads, Oportunidades -->
                    <li class="nav-item mt-3"><small class="section-label">Comercial</small></li>

                    <asp:PlaceHolder ID="phClientes" runat="server">
                        <li class="nav-item"><a class="nav-link" href="~/Clientes/ClienteLista.aspx" runat="server">Clientes</a></li>
                        <li class="nav-item"><a class="nav-link ps-4 small" href="~/Clientes/ContactosLista.aspx" runat="server">Contactos</a></li>
                        <asp:PlaceHolder ID="phImportarClientes" runat="server">
                            <li class="nav-item"><a class="nav-link ps-4 small" href="~/Clientes/ClientesImportar.aspx" runat="server">Importar Clientes</a></li>
                        </asp:PlaceHolder>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phLeads" runat="server">
                        <li class="nav-item"><a class="nav-link" href="~/Leads/LeadsLista.aspx" runat="server">Leads</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phOportunidades" runat="server">
                        <li class="nav-item"><a class="nav-link" href="~/Oportunidades/Pipeline.aspx" runat="server">Oportunidades</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phCatalogo" runat="server">
                        <li class="nav-item"><a class="nav-link" href="~/Catalogo/ProdutosLista.aspx" runat="server">Catálogo</a></li>
                    </asp:PlaceHolder>

                    <!-- Vendas: Propostas, Vendas -->
                    <li class="nav-item mt-3"><small class="section-label">Vendas</small></li>

                    <asp:PlaceHolder ID="phPropostas" runat="server">
                        <li class="nav-item"><a class="nav-link" href="~/Catalogo/PropostasLista.aspx" runat="server">Propostas</a></li>
                    </asp:PlaceHolder>

                    <asp:PlaceHolder ID="phVendas" runat="server">
                        <li class="nav-item"><a class="nav-link" href="~/Vendas/VendasLista.aspx" runat="server">Vendas</a></li>
                    </asp:PlaceHolder>

                    <!-- Análise -->
                    <asp:PlaceHolder ID="phRelatorios" runat="server">
                        <li class="nav-item mt-3"><small class="section-label">Análise</small></li>
                        <li class="nav-item"><a class="nav-link" href="~/Relatorios/Relatorios.aspx" runat="server">Relatórios</a></li>
                    </asp:PlaceHolder>

                    <!-- Administração -->
                    <asp:PlaceHolder ID="phAdministracao" runat="server">
                        <li class="nav-item mt-3"><small class="section-label">Administração</small></li>
                        <li class="nav-item"><a class="nav-link" href="~/Administracao/UtilizadoresLista.aspx" runat="server">Utilizadores</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Administracao/PerfisPermissoes.aspx" runat="server">Perfis e Permissões</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Administracao/Parametros.aspx" runat="server">Parâmetros</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Administracao/Auditoria.aspx" runat="server">Auditoria</a></li>
                    </asp:PlaceHolder>
                </ul>
            </nav>

            <!-- Área de conteúdo: só esta zona faz scroll -->
            <main class="app-content p-3 p-lg-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <asp:ContentPlaceHolder ID="Breadcrumb" runat="server" />
                    </ol>
                </nav>

                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </div>

        <!-- Rodapé: fixo, não faz scroll -->
        <footer class="text-center text-muted small py-2 border-top app-footer">
            &copy; <%: DateTime.Now.Year %> CRM Comercial
        </footer>

        <uc:Mensagens ID="ucMensagens" runat="server" />
        <uc:ConfirmacaoModal ID="ucConfirmacaoModal" runat="server" />
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="Scripts" runat="server" />
</body>
</html>